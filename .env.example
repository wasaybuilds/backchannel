# Deepgram — streaming speech-to-text. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Answer providers. Set any one or more. The first in PROVIDER_ORDER that has
# a key answers; if it fails (out of credit, bad key, overloaded, offline) the
# same question goes to the next, and the failed one is retried a few minutes
# later. Providers without a key are skipped.
# PROVIDER_ORDER=claude,openai,grok,groq,gemini

# Anthropic Claude. https://console.anthropic.com
ANTHROPIC_API_KEY=

# OpenAI. https://platform.openai.com/api-keys (starts with sk-)
OPENAI_API_KEY=
# OPENAI_FAST_MODEL=gpt-6-luna
# OPENAI_FULL_MODEL=gpt-6.1-terra

# xAI Grok. https://console.x.ai (starts with xai-)
XAI_API_KEY=
# GROK_FAST_MODEL=grok-4.7
# GROK_FULL_MODEL=grok-4.7

# Groq — open models on very fast hardware, free tier. https://console.groq.com
# (starts with gsk_). Text only: it cannot read the briefing PDFs, so put your
# CV in context/ as .md or .txt too. Screenshot questions skip it.
GROQ_API_KEY=
# GROQ_FAST_MODEL=openai/gpt-oss-20b
# GROQ_FULL_MODEL=openai/gpt-oss-120b

# Google Gemini. https://aistudio.google.com
GEMINI_API_KEY=
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_FULL_MODEL=gemini-3.6-flash

# Global shortcuts (optional). Defaults shown.
# These are system-wide: a bare Shift+H would swallow every capital H you type,
# which is why these use Alt. Electron accepts Alt / Control / Shift / Super.
# HOTKEY_HIDE=Alt+H
# HOTKEY_SHOW=Alt+S
# HOTKEY_ANSWER=Alt+Space
# HOTKEY_SCREEN=Alt+D
# HOTKEY_CODE=Alt+V
# HOTKEY_COPY=Alt+X
# HOTKEY_UP=Alt+Up
# HOTKEY_DOWN=Alt+Down
# HOTKEY_QUIT=Alt+Q

# What Deepgram listens for. Default en.
#   ur     Urdu on nova-3, returned in Urdu script
#   multi  code-switching, but its set is en/es/fr/de/hi/ru/pt/ja/it/nl — no Urdu
#   hi     Hindi; spoken Hindustani is near-identical to Urdu and IS in `multi`
# For Urdu-English interviews, multi is the one to use.
# STT_LANGUAGE=multi

# What Claude answers in. Free text, or `match` to answer in the language they
# asked in (Roman Urdu for Urdu). Default English.
# Both can also be switched live from the console's Language card.
# REPLY_LANGUAGE=match

# Control console — upload briefings and drive the overlay from a browser.
# CONSOLE_PORT=7331
# Bind to your LAN so a phone on the same Wi-Fi can reach it. The URL and a
# scannable QR are printed at startup; the token in it is not optional.
# CONSOLE_LAN=true

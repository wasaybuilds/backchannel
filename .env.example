# Deepgram — streaming speech-to-text. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Anthropic — the reasoning layer. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini — the fallback. https://aistudio.google.com
# Claude answers when it can; if it fails (out of credit, bad key, overloaded,
# offline) the same question goes to Gemini and Claude is retried a few
# minutes later. Either key alone also works.
GEMINI_API_KEY=
# GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# GEMINI_FULL_MODEL=gemini-3.6-flash

# Global shortcuts (optional). Defaults shown.
# These are system-wide: a bare Shift+H would swallow every capital H you type,
# which is why these use Alt. Electron accepts Alt / Control / Shift / Super.
# HOTKEY_HIDE=Alt+H
# HOTKEY_SHOW=Alt+S
# HOTKEY_ANSWER=Alt+Space
# HOTKEY_SCREEN=Alt+D
# HOTKEY_CODE=Alt+V
# HOTKEY_COPY=Alt+X
# HOTKEY_UP=Alt+Up
# HOTKEY_DOWN=Alt+Down
# HOTKEY_QUIT=Alt+Q

# What Deepgram listens for. Default en.
#   ur     Urdu on nova-3, returned in Urdu script
#   multi  code-switching, but its set is en/es/fr/de/hi/ru/pt/ja/it/nl — no Urdu
#   hi     Hindi; spoken Hindustani is near-identical to Urdu and IS in `multi`
# For Urdu-English interviews, multi is the one to use.
# STT_LANGUAGE=multi

# What Claude answers in. Free text, or `match` to answer in the language they
# asked in (Roman Urdu for Urdu). Default English.
# Both can also be switched live from the console's Language card.
# REPLY_LANGUAGE=match

# Control console — upload briefings and drive the overlay from a browser.
# CONSOLE_PORT=7331
# Bind to your LAN so a phone on the same Wi-Fi can reach it. The URL and a
# scannable QR are printed at startup; the token in it is not optional.
# CONSOLE_LAN=true

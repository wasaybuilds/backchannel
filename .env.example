# Deepgram — streaming speech-to-text. https://console.deepgram.com
DEEPGRAM_API_KEY=

# Anthropic — the reasoning layer. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Global shortcuts (optional). Defaults shown.
# These are system-wide: a bare Shift+H would swallow every capital H you type,
# which is why these use Alt. Electron accepts Alt / Control / Shift / Super.
# HOTKEY_HIDE=Alt+H
# HOTKEY_SHOW=Alt+S
# HOTKEY_ANSWER=Alt+Space
# HOTKEY_SCREEN=Alt+D
# HOTKEY_CODE=Alt+V
# HOTKEY_COPY=Alt+X
# HOTKEY_UP=Alt+Up
# HOTKEY_DOWN=Alt+Down
# HOTKEY_QUIT=Alt+Q
